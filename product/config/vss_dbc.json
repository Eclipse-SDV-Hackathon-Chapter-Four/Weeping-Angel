{
  "Vehicle": {
    "type": "branch",
    "description": "...",
    "children": {
      "Powertrain": {
        "type": "branch",
        "description": "...",
        "children": {
          "TractionBattery": {
            "type": "branch",
            "description": "...",
            "children": {
              "SourceTimestamp": {
                "datatype": "uint32",
                "type": "sensor",
                "description": "Source-relative generation timestamp",
                "unit": "ms",
                "dbc2vss": {
                  "signal": "TimeStamp",
                  "interval_ms": 50,
                  "on_change": false
                }
              },
              "Temperature": {
                "type": "branch",
                "description": "...",
                "children": {
                  "Average": {
                    "datatype": "float",
                    "type": "sensor",
                    "description": "Average cell temperature across pack",
                    "unit": "celsius",
                    "dbc2vss": {
                      "signal": "CellTempAvg",
                      "interval_ms": 50,
                      "on_change": false
                    }
                  },
                  "Max": {
                    "datatype": "float",
                    "type": "sensor",
                    "description": "Maximum cell temperature (hottest cell)",
                    "unit": "celsius",
                    "dbc2vss": {
                      "signal": "CellTempMax",
                      "interval_ms": 50,
                      "on_change": false
                    }
                  },
                  "Min": {
                    "datatype": "float",
                    "type": "sensor",
                    "description": "Minimum cell temperature (coldest cell)",
                    "unit": "celsius",
                    "dbc2vss": {
                      "signal": "CellTempMin",
                      "interval_ms": 50,
                      "on_change": false
                    }
                  }
                }
              },
              "StateOfCharge": {
                "type": "branch",
                "description": "...",
                "children": {
                  "Current": {
                    "datatype": "float",
                    "type": "sensor",
                    "description": "Battery state of charge percentage",
                    "unit": "percent",
                    "dbc2vss": {
                      "signal": "StateOfCharge",
                      "interval_ms": 50,
                      "on_change": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
